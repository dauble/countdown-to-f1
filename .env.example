# Yoto OAuth Credentials (get these from https://yoto.dev)
YOTO_CLIENT_ID=your_client_id_here
YOTO_CLIENT_SECRET=your_client_secret_here

# ElevenLabs API Key (required for TTS audio generation)
# Get a free key at https://elevenlabs.io/ — the free tier provides 10,000 characters/month
# which is sufficient for a single daily F1 update (~5,000–8,000 characters).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── Cloudflare Worker Integration (REQUIRED for auto-refresh / webhook) ────────
#
# CLOUDFLARE_WORKER_URL — the base URL of your deployed Cloudflare Worker.
#   Required by:
#     • POST /api/webhook/refresh-playlist  (GitHub Actions cron / manual trigger)
#     • The "Refresh Playlist from Worker" UI button
#   Example: https://f1-yoto-myo-worker.your-subdomain.workers.dev
#   Set in production: fly secrets set CLOUDFLARE_WORKER_URL=<url>
#   Set in GitHub Actions: add CLOUDFLARE_WORKER_URL as a repository secret
#     (Settings → Secrets and variables → Actions → New repository secret)
CLOUDFLARE_WORKER_URL=https://f1-yoto-myo-worker.your-subdomain.workers.dev

# USE_CLOUDFLARE_WORKER — set to 'true' to route the UI "Generate Card" flow
# through the Worker cache instead of calling OpenF1 directly. Optional.
USE_CLOUDFLARE_WORKER=false

# ─── Webhook Secret (REQUIRED for automated refresh) ────────────────────────────
#
# WEBHOOK_SECRET — shared secret used to authenticate requests to
#   POST /api/webhook/refresh-playlist.
#   Generate with: openssl rand -hex 32
#   Set in production: fly secrets set WEBHOOK_SECRET=<value>
#   Set in GitHub Actions: add WEBHOOK_SECRET as a repository secret
WEBHOOK_SECRET=your_random_secret_here

# Note: No other configuration needed!
# The app automatically detects the correct URL at runtime using request headers.
